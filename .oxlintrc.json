{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // The automatic JSX runtime ("jsx": "react-jsx") makes this unnecessary.
    "react/react-in-jsx-scope": "off",
    // oxlint namespaces these under `react`, not `react-hooks`.
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error"
  },
  // `openspec/**` holds design references, including a vendored runtime from the
  // design tool that exports the mocks. It is documentation, not our source.
  "ignorePatterns": ["dist", "src/routeTree.gen.ts", "openspec"]
}
