{
  "name": "hikari-ntu-homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --report-unused-disable-directives --max-warnings 0 .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "rc=0; failed=''; for s in format:check lint typecheck build; do npm run $s || { rc=1; failed=\"$failed $s\"; }; done; [ $rc -eq 0 ] && echo 'all checks passed' || echo \"FAILED:$failed\"; exit $rc",
    "preview": "vite preview"
  },
  "overrides": {
    "@google/model-viewer": {
      "three": "$three"
    }
  },
  "dependencies": {
    "@google/model-viewer": "^3.5.0",
    "@tanstack/react-router": "^1.170.16",
    "clsx": "^2.1.1",
    "dom-to-image": "^2.6.0",
    "jotai": "^2.20.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.21.0",
    "masonry-layout": "^4.2.2",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/dom-to-image": "^2.6.7",
    "@types/lodash": "^4.17.24",
    "@types/masonry-layout": "^4.2.8",
    "@types/node": "^26.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.38",
    "sass": "^1.90.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.0.16"
  }
}
